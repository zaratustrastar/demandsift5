# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# The worker image also backs the pre-deploy migration job. Keep psql in this
# image so DATABASE_URL never needs to be decomposed into individual secrets.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force

COPY --chown=node:node scripts ./scripts
COPY --chown=node:node db/migrations ./db/migrations

USER node

STOPSIGNAL SIGTERM

CMD ["node", "scripts/background-worker.mjs", "work"]
