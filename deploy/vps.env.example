# Copy this file to deploy/vps.env on the server and chmod it to 600.
# Never commit deploy/vps.env. Generate both secrets with: openssl rand -hex 32

DOMAIN=app.example.com
APP_URL=https://app.example.com
ACME_EMAIL=owner@example.com

APP_RUNTIME_ENV=production
NODE_ENV=production
STATE_STORE=postgres
AUTH_SECRET=replace-with-64-hex-characters

POSTGRES_DB=demandsift
POSTGRES_USER=demandsift
# Use URL-safe hex because this value is also interpolated into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-64-hex-characters

BACKGROUND_WORKER_MODE=queue
BACKGROUND_WORKER_SECRET=replace-with-64-hex-characters
BACKGROUND_JOB_POLL_MS=2000
# Runtime clamps this to 1200..1800 seconds; 900 was silently 1200.
BACKGROUND_JOB_TIMEOUT_SECONDS=1200
BACKGROUND_JOB_HEARTBEAT_SECONDS=15
BACKGROUND_JOB_LEASE_STALE_SECONDS=90
MONITOR_SCHEDULER_POLL_MS=60000
MONITOR_PASS_INTERVAL_HOURS=24
MONITOR_CORE_INTERVAL_MINUTES=360
# Independent opt-in daily Reddit monitoring. This does not enable the legacy
# full discovery rescan scheduler above.
REDDIT_MONITOR_SCHEDULER_ENABLED=true
REDDIT_MONITOR_SCHEDULER_POLL_MS=60000
REDDIT_MONITOR_FIRST_LOOKBACK_HOURS=24
REDDIT_MONITOR_ACTOR_ID=harshmaur/reddit-search-scraper
REDDIT_MONITOR_MAX_POSTS_PER_TERM=5
REDDIT_MONITOR_MAX_COMMENTS_PER_TERM=5
REDDIT_MONITOR_TIMEOUT_SECONDS=600

# OpenAI is called only from the web backend. These role defaults are configurable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# `auto` uses Responses for api.openai.com and Chat Completions for compatible gateways.
OPENAI_API_STYLE=auto
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_REPLY_MODEL=gpt-5.6-sol
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
# Comma-separated seller-capacity fallbacks. On the Surplus gateway, gpt-5.6-sol
# automatically falls back to gpt-5.5 when this is left blank.
OPENAI_ANALYSIS_FALLBACK_MODELS=
OPENAI_ECONOMY_FALLBACK_MODELS=
# Surplus users should currently override this with venice-embed-1.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# T11 opt-in coordinated exact-input attempt/deadline budget. Keep off until
# retry-injection and staging reliability/quality gates pass. Frozen per scan.
SCAN_COORDINATED_RETRIES=0
AI_RECOVERY_MAX_REQUESTS=20
AI_RECOVERY_DEADLINE_MS=900000
# T12 opt-in: preserves the complete triage schema/evidence and shortens only
# problem/reason prose. Keep off until provider-backed semantic gates pass.
SCAN_COMPACT_TRIAGE=0
# T13 measured-capacity controls. 25/4 preserve existing behavior. Values are
# frozen per accepted scan; do not raise concurrency before provider-backed
# rate-limit/quality tests and the T17 cross-worker capacity guard.
AI_TRIAGE_BATCH_SIZE=25
AI_REQUEST_CONCURRENCY=4
# T17 cross-process provider ceilings. Keep disabled with one executor. Enable
# before BACKGROUND_WORKER_CONCURRENCY=2 so a second lane cannot double the
# account-wide AI or active-Actor load.
PROVIDER_GLOBAL_CAPS=0
AI_GLOBAL_REQUEST_CONCURRENCY=4
APIFY_GLOBAL_ACTOR_CONCURRENCY=9
PROVIDER_CAPACITY_POLL_MS=250
AI_REQUEST_LEASE_SECONDS=360
BACKGROUND_WORKER_CONCURRENCY=1
BACKGROUND_WORKER_ROLE=combined
BACKGROUND_JOB_AGING_SECONDS=300
# Versioned live results are now production-enabled. They expose only the
# same access-filtered records the final report would expose and do not alter
# final qualification or relevance decisions.
SCAN_PARTIAL_RESULTS=1
# T19 deterministic new-scan rollout. A behavior's base flag must still be
# explicitly set to 1 elsewhere in this file; its percentage then selects a
# stable workspace cohort. Existing accepted scans retain their resolved
# receipt when percentages change.
SCAN_SPEED_INTERNAL_WORKSPACES=
SCAN_COORDINATED_RETRIES_ROLLOUT_PERCENT=100
SCAN_OVERLAP_DISCOVERY_TRIAGE_ROLLOUT_PERCENT=100
SCAN_COMPACT_TRIAGE_ROLLOUT_PERCENT=100
SCAN_PARTIAL_RESULTS_ROLLOUT_PERCENT=100

# USD per 1M tokens. Recheck provider pricing before changing models or going live.
OPENAI_ANALYSIS_INPUT_USD_PER_1M=5
OPENAI_ANALYSIS_CACHED_INPUT_USD_PER_1M=0.5
OPENAI_ANALYSIS_CACHE_WRITE_INPUT_USD_PER_1M=6.25
OPENAI_ANALYSIS_OUTPUT_USD_PER_1M=30
OPENAI_ANALYSIS_FALLBACK_INPUT_USD_PER_1M=5
OPENAI_ANALYSIS_FALLBACK_CACHED_INPUT_USD_PER_1M=0.5
OPENAI_ANALYSIS_FALLBACK_CACHE_WRITE_INPUT_USD_PER_1M=6.25
OPENAI_ANALYSIS_FALLBACK_OUTPUT_USD_PER_1M=30
OPENAI_ECONOMY_INPUT_USD_PER_1M=1
OPENAI_ECONOMY_CACHED_INPUT_USD_PER_1M=0.1
OPENAI_ECONOMY_CACHE_WRITE_INPUT_USD_PER_1M=1.25
OPENAI_ECONOMY_OUTPUT_USD_PER_1M=6
OPENAI_EMBEDDING_INPUT_USD_PER_1M=0.02
OPENAI_EMBEDDING_CACHED_INPUT_USD_PER_1M=0.02
OPENAI_EMBEDDING_CACHE_WRITE_INPUT_USD_PER_1M=0.02
OPENAI_EMBEDDING_OUTPUT_USD_PER_1M=0

# Safe default: mock. In production, select `harshmaur` -- it is the
# supported production discovery+enrichment provider (real thread/comment
# context via the harshmaur/reddit-scraper actor), no opt-in flag required.
# Trudax (`apify-test`) is selectable for internal testing only. There is no
# automatic cross-provider Reddit fallback; scan depth/routing stay explicit.
REDDIT_PROVIDER=mock
# Quality-equivalent overlap is production-enabled: AI triage starts as each
# Reddit query finishes instead of waiting for the slowest Actor. The final
# pool is still reconciled and fully covered before qualification.
SCAN_OVERLAP_DISCOVERY_TRIAGE=1
# Bound speculative candidate versions (0..200, default 100) across retries.
# Final coverage is NOT capped by this early-work limit.
SCAN_EARLY_TRIAGE_LIMIT=100
SCAN_EARLY_TRIAGE_FLUSH_MS=1000
REDDIT_API_BASE_URL=
REDDIT_API_KEY=
APIFY_REDDIT_TEST_MODE=false
APIFY_TOKEN=
APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper
APIFY_REDDIT_MAX_RESULTS=40
# Deep AI review is independent of thread/comment fetching: default 8, range
# 1..20. A legacy explicit REDDIT_ENRICHMENT_BUDGET is retained. Uncomment only
# to override; a value below an existing explicit legacy budget is rejected.
# REDDIT_DEEP_QUALIFICATION_BUDGET=8
# Thread-fetch cap only. Harshmaur supports 0 to disable extra thread fetches;
# this never disables or reduces deep AI review of the selected records.
APIFY_REDDIT_ENRICHMENT_LIMIT=8
APIFY_REDDIT_ENRICHMENT_COMMENTS=6
APIFY_REDDIT_TIMEOUT_MS=260000
APIFY_REDDIT_TIME_RANGE=year
# Harshmaur-specific overrides (optional; APIFY_TOKEN/APIFY_REDDIT_TIMEOUT_MS/
# APIFY_REDDIT_ENRICHMENT_LIMIT/APIFY_REDDIT_ENRICHMENT_COMMENTS above are
# reused for the fields the two providers' schemas share).
HARSHMAUR_REDDIT_ACTOR_ID=harshmaur/reddit-scraper
HARSHMAUR_REDDIT_MAX_RESULTS=250
HARSHMAUR_REDDIT_MAX_TERMS=12

# Optional direct Reddit posting. Register this exact HTTPS callback in the
# Reddit app first. Discovery may still use Apify while OAuth handles posting.
REDDIT_OAUTH_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://app.example.com/api/reddit/callback
REDDIT_USER_AGENT="web:com.demandsift.mvp:v0.1.0 (by /u/your_reddit_username)"
REDDIT_TOKEN_ENCRYPTION_KEY=
REDDIT_OAUTH_STATE_SECRET=

# Use Stripe test-mode credentials for end-to-end testing without real charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PASS_PRICE_ID=
STRIPE_CORE_PRICE_ID=
STRIPE_PASS_AMOUNT_CENTS=1200
STRIPE_CORE_AMOUNT_CENTS=3000
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
ENABLE_DEMO_STRIPE=false
